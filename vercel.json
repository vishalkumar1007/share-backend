{
  "version": 2,
  "functions": {
    "api/uploads.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/shares/[[...]].js": {
      "maxDuration": 30
    },
    "api/chat/[[...]].js": {
      "maxDuration": 30
    },
    "api/auth/[[...]].js": {
      "maxDuration": 20
    },
    "api/admin/[[...]].js": {
      "maxDuration": 20
    },
    "api/crons/cleanup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/crons/cleanup",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/s/:shareId",
      "destination": "/api/shares/:shareId"
    },
    {
      "source": "/api/user/:path*",
      "destination": "/api/legacy/user/:path*"
    },
    {
      "source": "/api/TextMultiverse/:path*",
      "destination": "/api/legacy/TextMultiverse/:path*"
    }
  ],
  "regions": ["iad1"]
}
