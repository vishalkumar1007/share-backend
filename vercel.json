{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/crons/cleanup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/crons/cleanup",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "regions": ["iad1"]
}
